# ─── Override config global segura ────────────────────────────────
# Tu config global en ~/.config/pnpm/rc tiene strict-dep-builds=true,
# ignore-scripts=true, y un allowBuilds global esperando decisión
# interactiva. Acá lo abrimos SOLO para los paquetes que lo necesitan.

strict-dep-builds=false
ignore-scripts=false

# ─── Cuarentena de paquetes recién publicados ─────────────────────
# Override local: 3 días (4320min) en vez de 4 (5760min global).
minimum-release-age=4320

# ─── Lockfile pnpm ────────────────────────────────────────────────
package-lock=true

# ─── Performance / workspace ───────────────────────────────────────
shared-workspace-lockfile=true
strict-peer-dependencies=false

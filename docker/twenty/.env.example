# Copy this file to docker/twenty/.env and fill in real values before running
# `pnpm twenty:up`. Never commit docker/twenty/.env — the repository's
# existing `.env*` gitignore rule already excludes it (verified: it matches
# at any depth, and `!.env.example` keeps this template trackable).

# Postgres password for the local Twenty database.
# Use a strong value without special characters that could break the
# connection string interpolation in docker-compose.yml.
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password

# Symmetric key Twenty uses to encrypt secrets at rest.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=replace_me_with_a_random_string

# Public URL where the local Twenty server is reachable. Used for auth
# callbacks and returned in API responses.
SERVER_URL=http://localhost:3000

# Bearer API key used by docker/twenty/scripts/create-fields.mjs to call
# Twenty's Metadata API. Generate it from the running instance's UI
# (Settings -> APIs & Webhooks) after `pnpm twenty:up` and the healthcheck
# pass. Not consumed by docker-compose.yml itself.
TWENTY_API_KEY=replace_me_with_an_api_key

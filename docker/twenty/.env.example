# Copy this file to docker/twenty/.env and fill in real values.
# docker/twenty/.env is git-ignored (matched by the repo's .env* rule) and
# must never be committed.

# Required: use `openssl rand -base64 32` — losing this key means losing
# access to everything encrypted with it (OAuth tokens, TOTP codes, etc.).
ENCRYPTION_KEY=replace_me_with_a_random_string

# Required: Postgres password for the local `db` service.
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters

# Required: where the server is reachable from the browser/API clients.
SERVER_URL=http://localhost:3000

# Required by docker/twenty/scripts/create-fields.mjs and import-crm-data.mjs.
# Only available after the stack is up: generate it from Twenty's own UI
# (Settings -> APIs & Webhooks) on first login.
TWENTY_API_KEY=replace_me_after_first_login

# Optional: which host interface the server's port 3000 is bound to.
# Leave unset for local dev (defaults to 0.0.0.0, open on the machine).
# On a production host reachable from the internet, set this to
# 127.0.0.1 so the port is only reachable through the host's own reverse
# proxy (see docker/twenty/PRODUCTION.md) -- never edit the compose file
# directly for this, it gets overwritten the next time it's re-copied.
# SERVER_BIND_HOST=127.0.0.1
